# AP1 INV-104 demo, testnet mode (`pnpm demo:inv104 --testnet`). Copy to demo/.env (untracked).
# Names only: never commit a value. Testnet and sandbox/fixture IBANs only.
# Also read: the root .env (MANDATE_CONTRACT_ID). The RPC variable is NEAR_RPC, as in scripts/owner/near.

# The deployed mandate contract (falls back to MANDATE_CONTRACT_ID)
CONTRACT_ID=
# Pays gas for the owner calls; needs a key in ~/.near-credentials/testnet/
SUBMITTER_ACCOUNT_ID=
# Folder with <contract>/owner-p256.json (pnpm keygen) and agents/<agent>.json (pnpm add-agent); default ~/.nearh-owner
OWNER_KEY_DIR=
# Optional, default https://rpc.testnet.near.org
NEAR_RPC=
# Default agent-1
AGENT_ID=
# Optional: the agent's function-call key; without it the add-agent key file is used. Never pass it on the command line.
AGENT_NEAR_PRIVATE_KEY=
# The supplier's first and "new bank" IBANs: Monerium sandbox or fixture values only, uppercase, no spaces
AP1_IBAN_A=
AP1_IBAN_B=
# Optional: supplier id; default acme-<unix time>, so every run uses a fresh supplier and INV-104 is unpaid
AP1_SUPPLIER=

# E1: one configuration for the seller, agent, M1 and owner verification. No private values here.
MANDATE_CONTRACT_ID=
AGENT_EVM_ADDRESS=
SAFE_ADDRESS=
BASE_SEPOLIA_RPC=
E1_SELLER_URL=
MCP_SELLER_ORIGINS=
E1_X402_MAX_UNITS=
E1_SUPPLIER=
E1_IBAN=
E1_IBAN_SALT=
E1_SEPA_AMOUNT=
E1_INVOICE_ID=
M1_URL=
M1_AGENT_TOKEN=
E1_DASHBOARD_URL=
NEAR_AI_API_KEY=
# Full interactive run only: exact Safe transfer amounts in token base units.
E1_TOPUP_USDC_UNITS=
E1_TOPUP_EURE_UNITS=
E1_ATTACK_IBAN=
E1_ATTACK_PAY_TO=
