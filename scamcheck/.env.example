# Scam check secrets (scamcheck/). Copy to scamcheck/.env (untracked).
# Names only: never commit a value. Loads only this file plus the shared root .env.

# --- NEAR AI Cloud: used by both the scam check and the agent runtime (agent/.env) ---
# Scam check is skipped, and labelled as skipped, if unset
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=
NEAR_AI_MODEL=
# Held queue storage directory (file-based JSON-lines)
SCAMCHECK_HELD_DIR=
